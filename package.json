{
  "name": "salestax-node",
  "version": "0.2.0",
  "description": "Official Node.js SDK for the Sales Tax Calculator API — immutable sales tax calculations, transactions, adjustments, batches, and coverage checks.",
  "license": "MIT",
  "homepage": "https://salestaxcalculatorapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InstaBlick-USA/salestax-node.git"
  },
  "bugs": "https://github.com/InstaBlick-USA/salestax-node/issues",
  "keywords": [
    "sales-tax",
    "tax-api",
    "ecommerce",
    "checkout",
    "nodejs",
    "api-client",
    "vat",
    "gst",
    "hst",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.4.0",
    "eslint": "^8.57.0",
    "globals": "^15.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.4.0"
  }
}
